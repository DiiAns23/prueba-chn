# ─────────────────────────────────────────────────────────────
# Plantilla de variables de entorno. Copia este archivo a .env
# y ajusta los valores antes de levantar el stack:
#   cp .env.example .env            (Linux/macOS)
#   Copy-Item .env.example .env     (Windows PowerShell)
# .env está en .gitignore: NUNCA se versiona (no subas secretos).
# ─────────────────────────────────────────────────────────────

# Contraseña de SQL Server (usuario sa) y de la app.
# Debe cumplir la política de complejidad de SQL Server.
DB_PASSWORD=ChangeMe_Strong!2026

# Secreto para firmar los JWT (mínimo 256 bits / 32+ caracteres).
JWT_SECRET=replace-with-a-long-random-256-bit-secret-change-me

# Contraseñas de los usuarios sembrados al arrancar (DataInitializer).
ADMIN_PASSWORD=ChangeMe_Admin!2026
OPERADOR_PASSWORD=ChangeMe_Operador!2026

# Opcional: si se define, siembra un cliente demo + usuario de autoservicio (rol CLIENTE).
CLIENTE_PASSWORD=ChangeMe_Cliente!2026

# ── Opcionales (ya tienen valor por defecto en application.yml) ──
#DB_URL=jdbc:sqlserver://sqlserver:1433;databaseName=chn_prestamos;encrypt=true;trustServerCertificate=true
#DB_USERNAME=sa
#JWT_EXP_MINUTES=120
#ADMIN_USERNAME=admin
#OPERADOR_USERNAME=operador

# Solo para docker-compose.registry.yml (imágenes desde GHCR), en minúsculas.
#GHCR_OWNER=tu-usuario-github
